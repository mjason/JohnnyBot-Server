[Unit]
Description=Johnny Bot MQTT and ACP service

[Service]
Type=exec
WorkingDirectory=%h
ConfigurationDirectory=johnnybot
ConfigurationDirectoryMode=0700
Environment=JOHNNYBOT_LISTEN=127.0.0.1:8883
EnvironmentFile=-%E/johnnybot/service.env
ExecStart=%h/.local/libexec/johnnybot/johnnybot serve -addr ${JOHNNYBOT_LISTEN} -host %H -data %E/johnnybot -workspace default=%h
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
KillMode=mixed
UMask=0077

[Install]
WantedBy=default.target
